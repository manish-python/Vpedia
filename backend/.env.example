# =============================================================================
# VPEDIA LEARNING — backend environment
#
# Copy to `.env` and adjust. `.env` is gitignored; never commit real values.
# =============================================================================

# --- Core --------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Database ---------------------------------------------------------------
# PostgreSQL is the primary database. The SQLite fallback below exists only
# for machines with no PostgreSQL available and must never be used when
# DEBUG is False, because the application relies on PostgreSQL partial
# unique constraints which SQLite does not enforce.
DATABASE_URL=postgresql://postgres:password@localhost:5432/vpedia
# USE_SQLITE=False

# --- CORS -------------------------------------------------------------------
# Explicit allowlist only. CORS_ALLOW_ALL_ORIGINS is never enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Frontend ---------------------------------------------------------------
# Origin of the React SPA. Used to build post-OAuth redirects and as a CSRF
# trusted origin. Must match the address you actually open in the browser.
FRONTEND_URL=http://localhost:5173

# --- Google OAuth -----------------------------------------------------------
# Where to obtain these: https://console.cloud.google.com/apis/credentials
#   1. Create a Google Cloud project (or pick an existing one).
#   2. Configure the OAuth consent screen.
#   3. Create an OAuth client ID of type "Web application".
#   4. Add the Authorized redirect URI shown below.
#
# Leave both values EMPTY to run without any OAuth surface: the project still
# boots, `/api/v1/auth/config/` reports `google_enabled: false`, and the Google
# routes are not registered at all. Nothing is half-configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. The redirect URI derived from your own configuration is:
#   Development : http://127.0.0.1:8000/api/v1/accounts/google/login/callback/
#   Production  : https://<your-backend-domain>/api/v1/accounts/google/login/callback/
# Set this only if you must pin it to something else; it must exactly match a
# value in the Google Cloud Console "Authorized redirect URIs" list.
GOOGLE_REDIRECT_URI=

# --- Sessions ---------------------------------------------------------------
# `Lax` works because the SPA and the API are same-site (localhost:5173 and
# localhost:8000 share the cookie jar; in production use app.example.com and
# api.example.com). Change to `None` + `SameSite=None; Secure` only if you have
# deliberately split the two across different registrable domains.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# --- UPI --------------------------------------------------------------------
# Seeded into the UPISettings singleton on first run. Administrators can
# change the live values later from Django Admin without touching code.
VPEDIA_UPI_ID=yourupi@bank
VPEDIA_UPI_NAME=VPEDIA LEARNING

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5

# --- Production hardening (enable behind HTTPS) ------------------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# USE_X_FORWARDED_PROTO=True
# LOG_LEVEL=INFO
