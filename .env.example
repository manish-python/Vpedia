# =============================================================================
# VPEDIA LEARNING — frontend environment
# Copy to `.env.local` and adjust. Only variables prefixed with VITE_ reach the
# browser bundle.
#
# IMPORTANT: no Google OAuth client id belongs in this file. Sign-in is a
# full-page redirect to the Django backend, which performs the OAuth exchange
# and sets the session cookie. The browser never sees a Google client id,
# client secret or OAuth token.
#
# There is deliberately NO payment-gateway variable here. Payment is collected
# manually over UPI: the backend serves the UPI ID, QR, amount and reference,
# and an administrator approves the submitted proof. Nothing in the browser
# can influence the amount.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Base URL of the Django REST API. Every service call in src/services/* goes
# through this seam.
#
# Leave as `/api/v1` in development: vite.config.ts proxies `/api` to
# http://127.0.0.1:8000, which keeps the HTTP-only session cookie first-party
# and avoids any cross-site cookie restriction.
#
# In production set an absolute URL, for example:
#   VITE_API_BASE_URL=https://api.vpedialearning.com/api/v1
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# Development only
# -----------------------------------------------------------------------------
# Where `npm run dev` proxies `/api` and `/admin`. Build-time only, and it never
# reaches the browser bundle. Change it if Django runs on a different port.
VITE_DEV_BACKEND=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Fixtures
# -----------------------------------------------------------------------------
# Adds artificial latency to the notifications list, which is the only surface
# still reading a local fixture. It has no backend endpoint.
#
# This is NOT a data-source switch. It does not fake classes, subjects,
# chapters, content, purchases, payments or access — those always come from
# PostgreSQL through Django, and an unreachable API produces an error, never
# sample content. Leave it false in production.
VITE_USE_MOCKS=false

# -----------------------------------------------------------------------------
# Backend must also be configured (backend/.env)
# -----------------------------------------------------------------------------
# FRONTEND_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
#
# Then register this exact redirect URI in Google Cloud Console:
#   http://localhost:5173/api/v1/accounts/google/login/callback/
# (trailing slash required)
#
# The Django Admin is proxied at /admin in development.